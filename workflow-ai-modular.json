      "parameters": {
        "functionCode": "const inputItems = $input.all();\nconst webhookJson = inputItems[0]?.json ?? {};\nconst body = webhookJson.body ?? webhookJson;\nconst papers = Array.isArray(body.papers) ? body.papers : (body.papers ? [body.papers] : []);\nconst question = body.question || '';\nconst papersList = papers.length ? papers.map((p, i) => `${i+1}. Title: ${p.title || 'Untitled'}\\nAbstract: ${p.abstract || 'N/A'}`).join('\\n\\n') : '';\nconst chatInput = `${papersList}\\n\\nQuestion: ${question}`;\nreturn [{\n  json: {\n    papers,\n    question,\n    papersJson: JSON.stringify(papers),\n    papersList,\n    chatInput,\n  },\n}];"
      },
