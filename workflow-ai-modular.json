    {
      "parameters": {
        "functionCode": "// Parse AI Agent outputs from each input index\nconst parseOutput = (output, fallback = {}) => {\n  if (!output) return fallback;\n  if (typeof output === 'string') {\n    try {\n      const jsonMatch = output.match(/\\{[^{}]*(?:\\{[^{}]*\\}[^{}]*)*\\}/);\n      if (jsonMatch) return JSON.parse(jsonMatch[0]);\n      return fallback;\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return output;\n};\n\nconst inputs = $input.all();\nconst summarization = parseOutput(\n  inputs[0]?.json?.output || inputs[0]?.json?.text || inputs[0]?.json?.response,\n  { summary: '', keyFindings: [], methodology: '' }\n);\nconst gapDetection = parseOutput(\n  inputs[1]?.json?.output || inputs[1]?.json?.text || inputs[1]?.json?.response,\n  { gaps: [], recommendations: [], priority: 'medium' }\n);\nconst trendDetection = parseOutput(\n  inputs[2]?.json?.output || inputs[2]?.json?.text || inputs[2]?.json?.response,\n  { trends: [], emergingAreas: [], futureDirections: [] }\n);\nconst visualization = parseOutput(\n  inputs[3]?.json?.output || inputs[3]?.json?.text || inputs[3]?.json?.response,\n  { visualizations: [], dataPoints: [] }\n);\nconst chatbot = parseOutput(\n  inputs[4]?.json?.output || inputs[4]?.json?.text || inputs[4]?.json?.response,\n  { botResponse: '', suggestedFollowUps: [], confidence: 'medium' }\n);\n\nreturn {\n  summarization,\n  gapDetection,\n  trendDetection,\n  visualization,\n  chatbot,\n  timestamp: new Date().toISOString(),\n  status: 'completed',\n  processingMode: 'modular-ai-agents'\n};"
      },
