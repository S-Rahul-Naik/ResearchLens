{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "N8N Final Payload",
  "type": "object",
  "required": ["summarization", "gapDetection", "trendDetection", "visualization", "timestamp", "status"],
  "additionalProperties": true,
  "properties": {
    "summarization": {
      "type": "object",
      "required": ["module1", "module2"],
      "properties": {
        "module1": {
          "type": "object",
          "required": ["summaries"],
          "properties": {
            "summaries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["paperId", "summary"],
                "properties": {
                  "paperId": { "type": "string" },
                  "summary": { "type": "string" },
                  "keyFindings": { "type": "array", "items": { "type": "string" } },
                  "keywords": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "module2": {
          "type": "object",
          "required": ["topics"],
          "properties": {
            "topics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "coherence": { "type": "number" },
                  "paperIds": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "gapDetection": {
      "type": "object",
      "required": ["gaps"],
      "properties": {
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gapId", "topicA", "topicB"],
            "properties": {
              "gapId": { "type": "string" },
              "topicA": { "type": "string" },
              "topicB": { "type": "string" },
              "explanation": { "type": "string" }
            }
          }
        }
      }
    },
    "trendDetection": {
      "type": "object",
      "required": ["module4_trends"],
      "properties": {
        "module4_trends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topicId", "topic", "trend"],
            "properties": {
              "topicId": { "type": "string" },
              "topic": { "type": "string" },
              "trend": { "type": "string" }
            }
          }
        }
      }
    },
    "visualization": {
      "type": "object",
      "required": ["module5"],
      "properties": {
        "module5": {
          "type": "object",
          "required": ["points"],
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y", "label"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "label": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string" }
  }
}
